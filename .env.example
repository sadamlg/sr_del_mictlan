# Valores locales de desarrollo; no contienen secretos reales.
COMPOSE_PROJECT_NAME=sr-del-mictlan

POSTGRES_DB=sr_del_mictlan
POSTGRES_USER=sr_mictlan
POSTGRES_PASSWORD=mictlan_dev
DATABASE_URL=postgresql://sr_mictlan:mictlan_dev@postgres:5432/sr_del_mictlan

FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=4000
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
MAILPIT_BIND_ADDRESS=127.0.0.1
MAILPIT_PORT=8025

NEXT_ALLOWED_DEV_ORIGIN=
MEDIA_BASE_URL=
ROBOTS_INDEXABLE=false

# Cuenta local: llaves oficiales de prueba de Cloudflare Turnstile; no sirven en Staging ni Producción.
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ENFORCE_CONTEXT=false

# Stripe Checkout local usa exclusivamente claves de prueba y el secreto de su listener actual.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_ENABLED=true
STRIPE_MEDIA_BASE_URL=

MAIL_FROM=Señor del Mictlán <no-reply@local.test>
RESEND_FROM=Señor del Mictlán · Compras <compras@local.test>
# Mailpit es el transporte local predeterminado. Resend es opcional y envía correo real.
EMAIL_TRANSPORT=smtp
RESEND_API_KEY=
